# Next.js Frontend Configuration
# When deployed to Vercel, set BACKEND_API_URL or NEXT_PUBLIC_API_URL
# to your production FastAPI backend URL (e.g., http://13.53.205.56:8000 or https://api.yourdomain.com).
# The Next.js rewrite proxy routes all /api/* requests to this backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_API_URL=http://localhost:8000
