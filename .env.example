# ==============================================================================
# AI Organization Agent — Environment Configuration Template
# All secrets must use secure placeholders. DO NOT commit actual credentials.
# ==============================================================================

# Application Environment
APP_NAME="AI Organization Agent"
APP_ENV=development
DEBUG=true

# Database Connection (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://ai_admin:ai_password@localhost:5433/ai_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_admin
POSTGRES_PASSWORD=ai_password

# AI / Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=false
GEMINI_COOLDOWN_SECONDS=300

# Neo4j Knowledge Graph (Optional / Mock mode if uninstalled)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_ENABLED=false

# Object Storage Configuration (Local fallback / AWS S3 / Cloudflare R2)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=ai-agent-datasets
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://pub-<id>.r2.dev
STORAGE_RETENTION_DAYS=30
STORAGE_DELETE_AFTER_INGESTION=false

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
